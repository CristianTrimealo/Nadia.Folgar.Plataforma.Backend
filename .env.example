NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGODB_URI=mongodb://localhost:27017/folgar-qa
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-secret-please-change-1234567890
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-1234567890
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

THROTTLE_TTL=60000
THROTTLE_LIMIT=20

# extractos-ia: 'stub' (default) no requiere credenciales. 'anthropic' usa Claude
# Sonnet 5 para estructurar los movimientos del PDF — requiere ANTHROPIC_API_KEY.
# 'openai' usa GPT-5.1 (u otro modelo vía OPENAI_MODEL) — requiere OPENAI_API_KEY.
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1
